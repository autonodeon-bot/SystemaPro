│   ├── database.py    # Подключение к БД
│   ├── auth.py        # JWT авторизация
│   ├── *_api.py       # Модульные роутеры API
│   └── Dockerfile
├── mobile/            # Flutter мобильное приложение
│   ├── lib/
│   │   ├── screens/   # Экраны
│   │   ├── services/  # Сервисы (API, auth, sync, и т.д.)
│   │   ├── models/    # Модели данных
│   │   ├── widgets/   # Виджеты
│   │   ├── providers/ # Riverpod провайдеры
│   │   └── theme/     # Тема приложения
│   └── pubspec.yaml
├── pages/             # React страницы
├── components/        # React компоненты
├── contexts/          # React контексты (Auth, Theme, Toast)
├── utils/             # Утилиты (cache, apiWithRetry)
├── styles/            # CSS переменные (design tokens)
├── nginx/             # Nginx конфигурация
