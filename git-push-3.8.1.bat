@echo off
chcp 65001 >nul
echo ========================================
echo   ПУШ ИЗМЕНЕНИЙ ВЕРСИИ 3.8.1 НА GITHUB
echo ========================================
echo.

echo [1/4] Проверка статуса git...
git status --short
echo.

echo [2/4] Добавление всех изменений...
git add .
if %ERRORLEVEL% NEQ 0 (
    echo   ОШИБКА: Не удалось добавить файлы!
    pause
    exit /b 1
)
echo   ✓ Файлы добавлены
echo.

echo [3/4] Создание коммита...
git commit -m "Версия 3.8.1: Обновления мобильного приложения, раскрывающийся список версий и исправления

- Обновлена версия мобильного приложения до 3.8.1 (build 6)
- Добавлен раскрывающийся список версий на странице 'Что нового' с анимацией
- Исправлена логика проверки обновлений: после установки APK приложение перепроверяет версию
- Исправлен MOBILE_APP_DOWNLOAD_URL в backend (правильный URL для скачивания APK)
- Обновлена конфигурация nginx: полное отключение кэша для всех файлов, включая APK
- Исправлена команда удаления Docker образов (фильтр SIZE)
- Добавлены скрипты для полной пересборки и деплоя системы
- Улучшена обработка ошибок при установке обновлений в мобильном приложении"
if %ERRORLEVEL% NEQ 0 (
    echo   ОШИБКА: Не удалось создать коммит!
    pause
    exit /b 1
)
echo   ✓ Коммит создан
echo.

echo [4/4] Отправка на GitHub...
git push
if %ERRORLEVEL% NEQ 0 (
    echo   ОШИБКА: Не удалось отправить на GitHub!
    echo   Проверьте настройки удаленного репозитория: git remote -v
    pause
    exit /b 1
)
echo   ✓ Изменения отправлены на GitHub
echo.

echo ========================================
echo   ГОТОВО
echo ========================================
echo.
echo Версия: 3.8.1
echo Коммит создан и отправлен на GitHub
echo.
pause
