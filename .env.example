# ============================================
# Секреты проекта «Монитор» / SystemaPro (ЕС ТД НГО)
# Скопируйте в .env и заполните реальными данными
# ============================================

# PostgreSQL
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
# Удалённый Postgres с TLS: require | verify-full | prefer. Локально без SSL: disable
DB_SSLMODE=require
DB_SSLCERT=/app/certs/root.crt

# JWT
JWT_SECRET_KEY=your-jwt-secret-key

# CORS (через запятую, без пробелов)
CORS_ORIGINS=https://neftcontrol.ru,http://localhost:5173,http://localhost:80
